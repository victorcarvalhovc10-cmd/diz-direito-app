# Copie este arquivo para ".env" (sem o ".example") e preencha sua chave.
# Pegue sua chave em: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=cole-sua-chave-aqui

# Quantos prompts gratuitos cada pessoa pode gerar por dia (teste local)
FREE_LIMIT_PER_DAY=8

# Porta em que o servidor vai rodar
PORT=3000
